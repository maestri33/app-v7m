# Contrato de env do front (server-side, NÃO exposto ao client).

# ── Backend Django+Ninja ─────────────────────────────────────────────────────
# Em dev o Django roda na porta 80 do host; em prod é o domínio público.
# DEV (Django local na 80 deste host)
# BACKEND_URL=http://localhost:80
# PROD
BACKEND_URL=https://backend.v7m.live

# NODE_ENV=production é setado pelo runtime (`node server.js`); com BACKEND_URL
# https, os cookies de sessão saem com `Secure` (lib/auth/cookies.ts).

# ── IA (CopilotKit → gateway OmniRoute, OpenAI-compatible) ────────────────────
# Server-side, NÃO exposto ao client. Usado SÓ pelo chat do comprovante de
# residência (needs_kinship). Se ficarem VAZIOS, a rota /api/copilotkit devolve
# 503 e a UI cai no FORMULÁRIO MANUAL — ninguém fica preso, mas o chat de IA
# some. Preencha em produção pra ligar o assistente:
# OMNIROUTE_BASE_URL=http://10.1.30.35:80
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto/best-vision   # opcional; default no código

# Desliga a telemetria de saída do CopilotKit (telemetry.copilotkit.ai) —
# recomendado em deploy restrito/offline.
COPILOTKIT_TELEMETRY_DISABLED=true
